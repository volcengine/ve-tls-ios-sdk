+    int terminal_successes;
+    int schema_valid;
+    int bad_wire;
+} ve_tls_config_contract_state;
+
+static int ve_tls_config_contract_bytes_are(
+    const unsigned char * bytes,
+    size_t size,
+    unsigned char value
+) {
+    for (size_t i = 0; i < size; i++) {
+        if (bytes[i] != value) return 0;
+    }
+    return 1;
+}
+
+static int ve_tls_config_contract_http_do(
+    ve_tls_http_client * client,
+    const ve_tls_http_request * request,
+    ve_tls_http_response * response
+) {
+    ve_tls_config_contract_state * state = client ? client->user_data : NULL;
+    if (!state || !request || !response ||
+        !request->method || strcmp(request->method, "POST") != 0 ||
+        !request->url || request->body_size == 0) {
+        if (state) {
+            state->platform.mutex_lock(state->mutex);
+            state->bad_wire = 1;
+            state->platform.mutex_unlock(state->mutex);
+        }
+        return -1;
+    }
+    state->platform.mutex_lock(state->mutex);
+    state->requests++;
+    state->platform.cond_broadcast(state->cond);
+    state->platform.mutex_unlock(state->mutex);
+    response->status_code = 200;
+    return 0;
+}
+
+static void ve_tls_config_contract_http_free(
+    ve_tls_http_client * client,
+    ve_tls_http_response * response
+) {
+    (void)client;
+    (void)response;
+}
+
+static void ve_tls_config_contract_send_done(
+    ve_tls_result result,
+    size_t log_bytes,
+    size_t compressed_bytes,
+    const char * request_id,
+    const char * error_message,
+    const unsigned char * raw_buffer,
+    void * user_param,
+    int64_t start_id,
+    int64_t end_id
+) {
+    (void)log_bytes;
+    (void)compressed_bytes;
+    (void)request_id;
+    (void)error_message;
+    (void)raw_buffer;
+    (void)start_id;
+    (void)end_id;
+    ve_tls_config_contract_state * state = user_param;
+    if (!state) return;
+    state->platform.mutex_lock(state->mutex);
+    state->callbacks++;
+    state->successes += result == VE_TLS_OK;
+    state->platform.cond_broadcast(state->cond);
+    state->platform.mutex_unlock(state->mutex);
+}
+
+static void ve_tls_config_contract_diagnostic(
+    const ve_tls_delivery_diagnostic * event,
+    void * user_param
+) {
+    ve_tls_config_contract_state * state = user_param;
+    if (!state || !event) return;
+    state->platform.mutex_lock(state->mutex);
+    state->diagnostics++;
+    if (event->metadata_version == VE_TLS_DELIVERY_DIAGNOSTIC_METADATA_VERSION_1 &&
+        event->metadata_size == sizeof(*event)) {
+        state->schema_valid = 1;
+    }
+    if (event->event == VE_TLS_DELIVERY_DIAGNOSTIC_BATCH_TERMINAL &&
+        event->reason == VE_TLS_DELIVERY_DIAGNOSTIC_REASON_SUCCESS) {
+        state->terminal_successes++;
+    }
+    state->platform.cond_broadcast(state->cond);
+    state->platform.mutex_unlock(state->mutex);
+}
+
+static int ve_tls_config_contract_state_init(
+    ve_tls_config_contract_state * state,
+    const ve_tls_platform * platform
+) {
+    memset(state, 0, sizeof(*state));
+    state->platform = *platform;
+    state->mutex = state->platform.mutex_create();
+    state->cond = state->platform.cond_create();
+    if (state->mutex && state->cond) return 0;
+    if (state->cond) state->platform.cond_destroy(state->cond);
+    if (state->mutex) state->platform.mutex_destroy(state->mutex);
+    memset(state, 0, sizeof(*state));
+    return -1;
+}
+
+static void ve_tls_config_contract_state_reset(
+    ve_tls_config_contract_state * state
+) {
+    state->platform.mutex_lock(state->mutex);
+    state->requests = 0;
+    state->callbacks = 0;
+    state->successes = 0;
+    state->diagnostics = 0;
+    state->terminal_successes = 0;
+    state->schema_valid = 0;
+    state->bad_wire = 0;
+    state->platform.mutex_unlock(state->mutex);
+}
+
+static void ve_tls_config_contract_state_destroy(
+    ve_tls_config_contract_state * state
+) {
+    if (!state || !state->mutex || !state->cond) return;
+    state->platform.cond_destroy(state->cond);
+    state->platform.mutex_destroy(state->mutex);
+    state->mutex = NULL;
+    state->cond = NULL;
+}
+
+static int ve_tls_config_contract_wait(
+    ve_tls_config_contract_state * state,
+    int requests,
+    int callbacks,
+    int diagnostics,
+    int terminal_successes
+) {
+    int64_t deadline = state->platform.time_ms() + 5000;
+    state->platform.mutex_lock(state->mutex);
+    while (state->requests < requests ||
+           state->callbacks < callbacks ||
+           state->diagnostics < diagnostics ||
+           state->terminal_successes < terminal_successes) {
+        int64_t remaining = deadline - state->platform.time_ms();
+        if (remaining <= 0) break;
+        state->platform.cond_timedwait_ms(state->cond, state->mutex, remaining);
+    }
+    int ok = state->requests >= requests &&
+        state->callbacks >= callbacks &&
+        state->diagnostics >= diagnostics &&
+        state->terminal_successes >= terminal_successes;
+    state->platform.mutex_unlock(state->mutex);
+    return ok ? 0 : -1;
+}
+
+#define VE_TLS_CONFIG_CONTRACT_CHECK(expression) do { \
+    if (!(expression)) { \
+        fprintf(stderr, "%s:%d: %s\n", __func__, __LINE__, #expression); \
+        rc = -1; \
+        goto done; \
+    } \
+} while (0)
+
+static int test_config_version_initialization_contract(void) {
+    int rc = 0;
+    ve_tls_config cfg;
+    ve_tls_config_contract_state state;
+    ve_tls_producer * producer = NULL;
+    int state_ready = 0;
+    const uint32_t versions[] = {
+        VE_TLS_CONFIG_VERSION_1,
+        VE_TLS_CONFIG_VERSION_2,
+        VE_TLS_CONFIG_VERSION_3
+    };
+    const size_t sizes[] = {
+        VE_TLS_CONFIG_VERSION_1_SIZE,
+        VE_TLS_CONFIG_VERSION_2_SIZE,
+        VE_TLS_CONFIG_VERSION_3_SIZE
+    };
+
+    ve_tls_config_contract_canary legacy_storage;
+    ve_tls_config legacy_expected;
+    memset(&legacy_storage, 0xA5, sizeof(legacy_storage));
+    memset(&legacy_expected, 0x3C, sizeof(legacy_expected));
+    ve_tls_config_init(&legacy_expected);
+    ve_tls_config_init(&legacy_storage.config);
+    VE_TLS_CONFIG_CONTRACT_CHECK(memcmp(
+        &legacy_storage.config,
+        &legacy_expected,
+        VE_TLS_CONFIG_LEGACY_SIZE) == 0);
+    VE_TLS_CONFIG_CONTRACT_CHECK(ve_tls_config_contract_bytes_are(
+        ((const unsigned char *)&legacy_storage.config) + VE_TLS_CONFIG_LEGACY_SIZE,
+        sizeof(legacy_storage.config) - VE_TLS_CONFIG_LEGACY_SIZE,
+        0xA5));
+    VE_TLS_CONFIG_CONTRACT_CHECK(ve_tls_config_contract_bytes_are(
+        legacy_storage.guard, sizeof(legacy_storage.guard), 0xA5));
+
+    for (size_t i = 0; i < 2; i++) {
+        ve_tls_config_contract_canary versioned_storage;
+        ve_tls_config versioned_expected;
+        memset(&versioned_storage, 0xA5, sizeof(versioned_storage));
+        memset(&versioned_expected, 0x3C, sizeof(versioned_expected));
+        VE_TLS_CONFIG_CONTRACT_CHECK(ve_tls_config_init_versioned(
+            &versioned_expected, sizes[i], versions[i]) == VE_TLS_OK);
+        VE_TLS_CONFIG_CONTRACT_CHECK(ve_tls_config_init_versioned(
+            &versioned_storage.config, sizes[i], versions[i]) == VE_TLS_OK);
+        VE_TLS_CONFIG_CONTRACT_CHECK(memcmp(
+            &versioned_storage.config, &versioned_expected, sizes[i]) == 0);
+        VE_TLS_CONFIG_CONTRACT_CHECK(ve_tls_config_contract_bytes_are(
+            ((const unsigned char *)&versioned_storage.config) + sizes[i],
+            sizeof(versioned_storage.config) - sizes[i],
+            0xA5));
+        VE_TLS_CONFIG_CONTRACT_CHECK(ve_tls_config_contract_bytes_are(
+            versioned_storage.guard, sizeof(versioned_storage.guard), 0xA5));
+    }
+
+    ve_tls_config_contract_canary v3_storage;
+    ve_tls_config v3_expected;
+    memset(&v3_storage, 0xA5, sizeof(v3_storage));
+    memset(&v3_expected, 0x3C, sizeof(v3_expected));
+    VE_TLS_CONFIG_CONTRACT_CHECK(ve_tls_config_init_versioned(
+        &v3_expected, VE_TLS_CONFIG_VERSION_3_SIZE, VE_TLS_CONFIG_VERSION_3) == VE_TLS_OK);
+    VE_TLS_CONFIG_CONTRACT_CHECK(ve_tls_config_init_versioned(
+        &v3_storage.config, VE_TLS_CONFIG_VERSION_3_SIZE, VE_TLS_CONFIG_VERSION_3) == VE_TLS_OK);
+    VE_TLS_CONFIG_CONTRACT_CHECK(memcmp(
+        &v3_storage.config, &v3_expected, sizeof(v3_storage.config)) == 0);
+    VE_TLS_CONFIG_CONTRACT_CHECK(v3_storage.config.memory_retry_retention_ms == 0);
+    VE_TLS_CONFIG_CONTRACT_CHECK(v3_storage.config.bound_request_timeout_to_retry_budget == 0);
+    VE_TLS_CONFIG_CONTRACT_CHECK(v3_storage.config.delivery_diagnostic == NULL);
+    VE_TLS_CONFIG_CONTRACT_CHECK(v3_storage.config.delivery_diagnostic_param == NULL);
+    VE_TLS_CONFIG_CONTRACT_CHECK(v3_storage.config.retry_transient_http_errors == 0);
+    VE_TLS_CONFIG_CONTRACT_CHECK(ve_tls_config_contract_bytes_are(
+        v3_storage.guard, sizeof(v3_storage.guard), 0xA5));
+
+    VE_TLS_CONFIG_CONTRACT_CHECK(ve_tls_config_init_versioned(
+        &cfg, sizeof(cfg), VE_TLS_CONFIG_VERSION_3) == VE_TLS_OK);
+    cfg.endpoint = "https://example.com";
+    cfg.region = "cn-beijing";
+    cfg.topic_id = "topic";
+    cfg.access_key_id = "ak";
+    cfg.access_key_secret = "sk";
+    cfg.compress_type = "none";
+    cfg.send_thread_count = 1;
+    cfg.pack_thread_count = 1;
+    cfg.flush_interval_ms = 1;
+    cfg.log_count_per_package = 1;
+    cfg.retry_policy.max_attempts = 1;
+    cfg.http_client.do_request = ve_tls_config_contract_http_do;
+    cfg.http_client.free_response = ve_tls_config_contract_http_free;
+    cfg.delivery_diagnostic = ve_tls_config_contract_diagnostic;
+
+    VE_TLS_CONFIG_CONTRACT_CHECK(ve_tls_config_contract_state_init(
+        &state, &cfg.platform) == 0);
+    state_ready = 1;
+    cfg.http_client.user_data = &state;
+    cfg.delivery_diagnostic_param = &state;
+
+    producer = ve_tls_producer_create_versioned(
+        &cfg, VE_TLS_CONFIG_VERSION_3_SIZE, VE_TLS_CONFIG_VERSION_3);
+    VE_TLS_CONFIG_CONTRACT_CHECK(producer != NULL);
+    ve_tls_producer_set_send_done(producer, ve_tls_config_contract_send_done, &state);
+    ve_tls_kv kv = {"message", "config-version-contract"};
+    VE_TLS_CONFIG_CONTRACT_CHECK(ve_tls_producer_add_log_kv(
+        producer, state.platform.time_ms(), &kv, 1, 1) == VE_TLS_OK);
+    VE_TLS_CONFIG_CONTRACT_CHECK(ve_tls_config_contract_wait(&state, 1, 1, 1, 1) == 0);
+    VE_TLS_CONFIG_CONTRACT_CHECK(state.successes >= 1 && state.schema_valid == 1);
+    VE_TLS_CONFIG_CONTRACT_CHECK(state.bad_wire == 0);
+    VE_TLS_CONFIG_CONTRACT_CHECK(ve_tls_producer_close(producer, 5000) == VE_TLS_OK);
+    ve_tls_producer_destroy(producer);
+    producer = NULL;
+
+    /* Reuse the V3-populated config: legacy create consumes only its prefix. */
+    ve_tls_config_contract_state_reset(&state);
+    producer = ve_tls_producer_create(&cfg);
+    VE_TLS_CONFIG_CONTRACT_CHECK(producer != NULL);
+    ve_tls_producer_set_send_done(producer, ve_tls_config_contract_send_done, &state);
+    VE_TLS_CONFIG_CONTRACT_CHECK(ve_tls_producer_add_log_kv(
+        producer, state.platform.time_ms(), &kv, 1, 1) == VE_TLS_OK);
+    VE_TLS_CONFIG_CONTRACT_CHECK(ve_tls_config_contract_wait(&state, 1, 1, 0, 0) == 0);
+    VE_TLS_CONFIG_CONTRACT_CHECK(state.diagnostics == 0);
+    VE_TLS_CONFIG_CONTRACT_CHECK(state.successes >= 1 && state.bad_wire == 0);
+    VE_TLS_CONFIG_CONTRACT_CHECK(ve_tls_producer_close(producer, 5000) == VE_TLS_OK);
+    ve_tls_producer_destroy(producer);
+    producer = NULL;
+
+done:
+    if (producer) {
+        (void)ve_tls_producer_close(producer, 5000);
+        ve_tls_producer_destroy(producer);
+    }
+    if (state_ready) ve_tls_config_contract_state_destroy(&state);
+    return rc;
+}
+
+#undef VE_TLS_CONFIG_CONTRACT_CHECK
+
+#endif
diff --git a/tests/test_delivery_thread_cases.inc b/tests/test_delivery_thread_cases.inc
new file mode 100644
index 0000000..fee62ab
--- /dev/null
+++ b/tests/test_delivery_thread_cases.inc
@@ -0,0 +1,885 @@
+/* Real sender-thread retention coverage.  This file is textually included by
+ * test_basic.c after its internal test fixtures, so it may use the internal
+ * producer/queue types only to build a deterministic allocator fixture. */
+
+#define TLS_THREAD_MAX_SCHEDULED 64
+
+typedef enum {
+    TLS_THREAD_HTTP_RETRY = 0,
+    TLS_THREAD_HTTP_REQUEUE_OOM = 1
+} tls_thread_http_mode;
+
+typedef struct tls_thread_state {
+    ve_tls_platform platform;
+    ve_tls_mutex * mutex;
+    ve_tls_cond * cond;
+    ve_tls_producer * producer;
+    tls_thread_http_mode http_mode;
+    int64_t http_sleep_ms;
+    int http_success;
+    int request_count;
+    int callback_count;
+    int callback_v1_count;
+    int retained_count;
+    int terminal_count;
+    int scheduled_count;
+    int provider_calls;
+    int schema_error;
+    int oom_fixture_error;
+    int credential_test_clock;
+    int oom_hit;
+    ve_tls_result result;
+    ve_tls_result callback_v1_result;
+    ve_tls_delivery_diagnostic_reason terminal_reason;
+    ve_tls_delivery_diagnostic_disposition terminal_disposition;
+    ve_tls_delivery_diagnostic_disposition retained_disposition;
+    char terminal_error_code[64];
+    char callback_error_code[64];
+    char callback_v1_error_message[128];
+    int64_t scheduled_elapsed[TLS_THREAD_MAX_SCHEDULED];
+} tls_thread_state;
+
+/* The producer under the credentials-deadline test sees this wrapper, while
+ * tls_thread_wait continues to use state.platform.time_ms directly. */
+static _Atomic int64_t tls_thread_clock_offset_ms;
+static int64_t (*tls_thread_clock_base_ms)(void);
+
+static int64_t tls_thread_clock_ms(void) {
+    int64_t base = tls_thread_clock_base_ms ? tls_thread_clock_base_ms() : 0;
+    int64_t offset = atomic_load_explicit(&tls_thread_clock_offset_ms, memory_order_relaxed);
+    if (offset > 0 && base > INT64_MAX - offset) return INT64_MAX;
+    if (offset < 0 && base < INT64_MIN - offset) return INT64_MIN;
+    return base + offset;
+}
+
+static void tls_thread_clock_reset(void) {
+    atomic_store_explicit(&tls_thread_clock_offset_ms, 0, memory_order_relaxed);
+    tls_thread_clock_base_ms = NULL;
+}
+
+static int64_t tls_thread_provider_now(const tls_thread_state * state) {
+    if (state && state->credential_test_clock) return tls_thread_clock_ms();
+    return state && state->platform.time_ms ? state->platform.time_ms() : 0;
+}
+
+static int tls_thread_state_init(tls_thread_state * state) {
+    if (!state) return -1;
+    memset(state, 0, sizeof(*state));
+    state->result = VE_TLS_INVALID;
+    ve_tls_platform_init_default(&state->platform);
+    state->mutex = state->platform.mutex_create();
+    state->cond = state->platform.cond_create();
+    if (!state->mutex || !state->cond) {
+        if (state->cond) state->platform.cond_destroy(state->cond);
+        if (state->mutex) state->platform.mutex_destroy(state->mutex);
+        memset(state, 0, sizeof(*state));
+        return -1;
+    }
+    return 0;
+}
+
+static void tls_thread_state_destroy(tls_thread_state * state) {
+    if (!state) return;
+    if (state->cond) state->platform.cond_destroy(state->cond);
+    if (state->mutex) state->platform.mutex_destroy(state->mutex);
+    memset(state, 0, sizeof(*state));
+}
+
+typedef int (*tls_thread_predicate)(const tls_thread_state * state);
+
+static int tls_thread_wait(
+    tls_thread_state * state,
+    tls_thread_predicate predicate,
+    int64_t timeout_ms
+) {
+    if (!state || !predicate || timeout_ms < 0) return -1;
+    int64_t now = state->platform.time_ms ? state->platform.time_ms() : 0;
+    int64_t deadline = now > INT64_MAX - timeout_ms ? INT64_MAX : now + timeout_ms;
+    state->platform.mutex_lock(state->mutex);
+    while (!predicate(state)) {
+        now = state->platform.time_ms ? state->platform.time_ms() : deadline;
+        int64_t remaining = deadline - now;
+        if (remaining <= 0) break;
+        if (!state->platform.cond_timedwait_ms ||
+            state->platform.cond_timedwait_ms(state->cond, state->mutex, remaining) != 0) {
+            break;
+        }
+    }
+    int ok = predicate(state);
+    state->platform.mutex_unlock(state->mutex);
+    return ok ? 0 : -1;
+}
+
+static int tls_thread_pred_retained(const tls_thread_state * state) {
+    return state && state->retained_count >= 1;
+}
+
+static int tls_thread_pred_terminal(const tls_thread_state * state) {
+    return state && state->terminal_count >= 1 && state->callback_count >= 1;
+}
+
+static int tls_thread_wait_quiet(tls_thread_state * state, int64_t timeout_ms) {
+    if (!state || timeout_ms < 0) return -1;
+    state->platform.mutex_lock(state->mutex);
+    if (state->platform.cond_timedwait_ms) {
+        (void)state->platform.cond_timedwait_ms(state->cond, state->mutex, timeout_ms);
+    } else if (state->platform.sleep_ms) {
+        state->platform.mutex_unlock(state->mutex);
+        state->platform.sleep_ms(timeout_ms);
+        return 0;
+    }
+    state->platform.mutex_unlock(state->mutex);
+    return 0;
+}
+
+static void tls_thread_reset_observations(tls_thread_state * state) {
+    if (!state) return;
+    state->platform.mutex_lock(state->mutex);
+    state->producer = NULL;
+    state->request_count = 0;
+    state->callback_count = 0;
+    state->callback_v1_count = 0;
+    state->retained_count = 0;
+    state->terminal_count = 0;
+    state->scheduled_count = 0;
+    state->provider_calls = 0;
+    state->schema_error = 0;
+    state->oom_fixture_error = 0;
+    state->result = VE_TLS_INVALID;
+    state->callback_v1_result = VE_TLS_INVALID;
+    state->terminal_reason = VE_TLS_DELIVERY_DIAGNOSTIC_REASON_NONE;
+    state->terminal_disposition = VE_TLS_DELIVERY_DIAGNOSTIC_DISPOSITION_UNKNOWN;
+    state->retained_disposition = VE_TLS_DELIVERY_DIAGNOSTIC_DISPOSITION_UNKNOWN;
+    memset(state->terminal_error_code, 0, sizeof(state->terminal_error_code));
+    memset(state->callback_error_code, 0, sizeof(state->callback_error_code));
+    memset(state->callback_v1_error_message, 0, sizeof(state->callback_v1_error_message));
+    memset(state->scheduled_elapsed, 0, sizeof(state->scheduled_elapsed));
+    state->platform.mutex_unlock(state->mutex);
+}
+
+static int tls_thread_pred_two_retained(const tls_thread_state * state) {
+    return state && state->retained_count >= 2 && state->scheduled_count >= 3;
+}
+
+static int tls_thread_elapsed_is_cumulative(const tls_thread_state * state) {
+    if (!state || state->scheduled_count <= 0 || state->scheduled_count > TLS_THREAD_MAX_SCHEDULED) {
+        return 0;
+    }
+    int64_t previous = -1;
+    for (int i = 0; i < state->scheduled_count; i++) {
+        if (state->scheduled_elapsed[i] < 0 ||
+            (previous >= 0 && state->scheduled_elapsed[i] < previous)) {
+            return 0;
+        }
+        previous = state->scheduled_elapsed[i];
+    }
+    return 1;
+}
+
+static void tls_thread_diagnostic(
+    const ve_tls_delivery_diagnostic * event,
+    void * user_param
+) {
+    tls_thread_state * state = (tls_thread_state *)user_param;
+    if (!state || !event) return;
+    state->platform.mutex_lock(state->mutex);
+    if (event->metadata_version != VE_TLS_DELIVERY_DIAGNOSTIC_METADATA_VERSION_1 ||
+        event->metadata_size != sizeof(*event)) {
+        state->schema_error = 1;
+    }
+    if (event->event == VE_TLS_DELIVERY_DIAGNOSTIC_RETRY_SCHEDULED) {
+        if (state->scheduled_count < TLS_THREAD_MAX_SCHEDULED) {
+            state->scheduled_elapsed[state->scheduled_count] = event->elapsed_ms;
+        } else {
+            state->schema_error = 1;
+        }
+        state->scheduled_count++;
+    } else if (event->event == VE_TLS_DELIVERY_DIAGNOSTIC_BATCH_RETAINED) {
+        state->retained_count++;
+        state->retained_disposition = event->disposition;
+    } else if (event->event == VE_TLS_DELIVERY_DIAGNOSTIC_BATCH_TERMINAL) {
+        state->terminal_count++;
+        state->terminal_reason = event->reason;
+        state->terminal_disposition = event->disposition;
+        snprintf(
+            state->terminal_error_code,
+            sizeof(state->terminal_error_code),
+            "%s",
+            event->error_code ? event->error_code : "");
+    }
+    state->platform.cond_broadcast(state->cond);
+    state->platform.mutex_unlock(state->mutex);
+}
+
+static void tls_thread_done(
+    ve_tls_result result,
+    size_t log_bytes,
+    size_t compressed_bytes,
+    const ve_tls_error * error,
+    const unsigned char * raw_buffer,
+    void * user_param,
+    int64_t start_id,
+    int64_t end_id
+) {
+    (void)log_bytes;
+    (void)compressed_bytes;
+    (void)raw_buffer;
+    (void)start_id;
+    (void)end_id;
+    tls_thread_state * state = (tls_thread_state *)user_param;
+    if (!state) return;
+    state->platform.mutex_lock(state->mutex);
+    state->callback_count++;
+    state->result = result;
+    snprintf(
+        state->callback_error_code,
+        sizeof(state->callback_error_code),
+        "%s",
+        error && error->error_code ? error->error_code : "");
+    state->platform.cond_broadcast(state->cond);
+    state->platform.mutex_unlock(state->mutex);
+}
+
+static void tls_thread_done_v1(
+    ve_tls_result result,
+    size_t log_bytes,
+    size_t compressed_bytes,
+    const char * req_id,
+    const char * error_message,
+    const unsigned char * raw_buffer,
+    void * user_param,
+    int64_t start_id,
+    int64_t end_id
+) {
+    (void)log_bytes;
